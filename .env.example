POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# How long to wait for Postgres to accept a connection, and how the connection pool behaves.
# Keep pool_size + max_overflow, times the number of backend replicas, below Postgres's
# max_connections (100 by default). A request that cannot get a connection within the pool
# timeout fails with a 503 instead of waiting.
# DATABASE_CONNECT_TIMEOUT_SECONDS=3
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=5

BASE_URL=http://localhost:8000

# Redirect cache. The password is required by Docker Compose, because the cache decides
# where cached links redirect. For the backend on the host, set REDIS_HOST too (127.0.0.1,
# not localhost: see above); leave REDIS_HOST empty to run without a cache.
# Use letters and digits for passwords, e.g. `openssl rand -hex 16`: in a .env file Docker
# Compose expands $ and a dotenv reader treats ' #' as a comment, so other characters can
# silently change the value and make Redis and the backend disagree on the password.
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Managed cloud Redis (ElastiCache, Azure Cache, ...) usually requires TLS:
# REDIS_TLS=true
# CACHE_TTL_SECONDS=3600
